# Root-level reference. Actual runtime values live in:
#   apps/web/.env.local      (browser-safe keys)
#   apps/worker/.env         (service role key; never commit)
# This file is checked into git as documentation only.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Open-Meteo (worker only) ----
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# ---- Worker tuning ----
POLL_INTERVAL_MINUTES=10
