# Supabase project URL. Same value as NEXT_PUBLIC_SUPABASE_URL on the web app.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Service Role key. NEVER expose this to the browser.
# Worker writes to live_context + context_history with this key to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (defaults are fine).
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# How often the worker polls (minutes). Default 10.
POLL_INTERVAL_MINUTES=10
